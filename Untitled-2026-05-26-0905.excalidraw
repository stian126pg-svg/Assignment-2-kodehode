      "updated": 1781004668002,
      "link": null,
      "locked": false,
      "text": "User gets a neat but simple overview of:\n-Date. Time. Day.\n-To-Do tasks for said day. Alerts when it is time\nfor \"meeting\"/\"appointment\"/\"task\" to be completed\n-Can choose to view different time-zones\n-A \"log-out\" function!",
      "fontSize": 8.355762532249125,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "User gets a neat but simple overview of:\n-Date. Time. Day.\n-To-Do tasks for said day. Alerts when it is time\nfor \"meeting\"/\"appointment\"/\"task\" to be completed\n-Can choose to view different time-zones\n-A \"log-out\" function!",
      "autoResize": true,
      "lineHeight": 1.25
    }
